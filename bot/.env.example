# ==================== TELEGRAM ====================
BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
ADMIN_IDS=123456789,987654321

# ==================== POSTGRES ====================
POSTGRES_USER=support_user
POSTGRES_PASSWORD=support_pass
POSTGRES_DB=support_bot
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# SQLAlchemy DSN (avtomatik yig'iladi, lekin override qilsa bo'ladi)
DATABASE_URL=postgresql+asyncpg://support_user:support_pass@postgres:5432/support_bot

# ==================== OCR ====================
OCR_LANGUAGES=ru,en
OCR_USE_GPU=false
OCR_MIN_CONFIDENCE=0.3

# ==================== MATCHING ====================
FUZZY_MATCH_THRESHOLD=70

# ==================== STORAGE ====================
IMAGE_STORAGE_PATH=storage/images

# ==================== API ====================
API_HOST=0.0.0.0
API_PORT=8000

# ==================== LOG ====================
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log

# ==================== VISION AI ====================
# Anthropic API key — Vision AI fallback uchun (ixtiyoriy)
ANTHROPIC_API_KEY=sk-ant-...
# Har bir foydalanuvchi uchun kunlik Vision AI so'rovlar limiti
VISION_DAILY_LIMIT_PER_USER=10
